 "content": "[{\"data\": {\"col\": 12, \"text\": \"<span class=\\\"h4\\\"><b>Upande Spatial</b></span>\"}, \"id\": \"header\", \"type\": \"header\"}, {\"data\": {\"col\": 12, \"text\": \"One place for every map feature in ERP - farm and block boundaries, warehouses, water networks and other utility lines (pipes, power and internet cables) - drawn here, in QGIS or in the field app, and linked to the records they belong to. Water networks can be simulated with EPANET, and field teams inspect assets along planned routes.\"}, \"id\": \"para\", \"type\": \"paragraph\"}, {\"data\": {\"col\": 12, \"text\": \"Shortcuts\"}, \"id\": \"shortcuts_header\", \"type\": \"header\"}, {\"data\": {\"col\": 3, \"shortcut_name\": \"Spatial Feature\"}, \"id\": \"shortcuts\", \"type\": \"shortcut\"}, {\"data\": {\"col\": 3, \"shortcut_name\": \"Spatial Entity Config\"}, \"id\": \"shortcuts2\", \"type\": \"shortcut\"}, {\"data\": {\"col\": 3, \"shortcut_name\": \"Map Viewer\"}, \"id\": \"shortcuts3\", \"type\": \"shortcut\"}, {\"data\": {\"col\": 3, \"shortcut_name\": \"Map Viewer Plugins\"}, \"id\": \"shortcuts4\", \"type\": \"shortcut\"}, {\"data\": {\"col\": 3, \"shortcut_name\": \"Spatial Data Catalog\"}, \"id\": \"shortcuts5\", \"type\": \"shortcut\"}, {\"id\": \"inspections_header\", \"type\": \"header\", \"data\": {\"col\": 12, \"text\": \"Field Inspections\"}}, {\"id\": \"inspection_shortcut1\", \"type\": \"shortcut\", \"data\": {\"col\": 3, \"shortcut_name\": \"Inspection Plans\"}}, {\"id\": \"inspection_shortcut2\", \"type\": \"shortcut\", \"data\": {\"col\": 3, \"shortcut_name\": \"Open Inspection Runs\"}}, {\"id\": \"inspection_shortcut3\", \"type\": \"shortcut\", \"data\": {\"col\": 3, \"shortcut_name\": \"Failed Checks\"}}, {\"id\": \"sensors_header\", \"type\": \"header\", \"data\": {\"col\": 12, \"text\": \"Sensors\"}}, {\"id\": \"sensor_shortcut\", \"type\": \"shortcut\", \"data\": {\"col\": 3, \"shortcut_name\": \"Network Sensors\"}}, {\"id\": \"modules_header\", \"type\"